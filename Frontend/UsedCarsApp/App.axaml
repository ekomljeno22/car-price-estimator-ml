<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UsedCarsApp.ViewModels"
             x:Class="UsedCarsApp.App"
             RequestedThemeVariant="Dark">

    <Application.DataContext>
        <vm:ViewModelLocator />
    </Application.DataContext>

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#2563EB</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            <Color x:Key="SuccessColor">#16A34A</Color>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

            <Color x:Key="ErrorColor">#DC2626</Color>
            <SolidColorBrush x:Key="ErrorBrush"  Color="{StaticResource ErrorColor}" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundPointerOver" Color="#1E293B" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundPointerOver" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelected" Color="#F97316" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelected" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelectedPointerOver" Color="#FB923C" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelectedPointerOver" Color="#FFFFFF" />
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundPointerOver" Color="#1E293B" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundPointerOver" Color="#FFFFFF" />
                    
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelected" Color="#F97316" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelected" Color="#FFFFFF" />
                    
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelectedPointerOver" Color="#FB923C" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelectedPointerOver" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#1F2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Styles>
</Application>
