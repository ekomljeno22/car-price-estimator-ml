<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UsedCarsApp.ViewModels"
             x:Class="UsedCarsApp.App"
             RequestedThemeVariant="Dark">

    <Application.DataContext>
        <vm:ViewModelLocator />
    </Application.DataContext>

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#2563EB</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FB923C" />
            <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#060B12" />
            <SolidColorBrush x:Key="CardBrush" Color="#0D1829" />
            <SolidColorBrush x:Key="CardInnerBrush" Color="#0A1520" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#1E3048" />
            <SolidColorBrush x:Key="TextMainBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="TextSoftBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#B0060B12" />

            <Color x:Key="SuccessColor">#16A34A</Color>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

            <Color x:Key="ErrorColor">#DC2626</Color>
            <SolidColorBrush x:Key="ErrorBrush"  Color="{StaticResource ErrorColor}" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundPointerOver" Color="#1E293B" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundPointerOver" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelected" Color="#F97316" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelected" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelectedPointerOver" Color="#FB923C" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelectedPointerOver" Color="#FFFFFF" />
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundPointerOver" Color="#1E293B" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundPointerOver" Color="#FFFFFF" />
                    
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelected" Color="#F97316" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelected" Color="#FFFFFF" />
                    
                    <SolidColorBrush x:Key="ComboBoxItemThemeBackgroundSelectedPointerOver" Color="#FB923C" />
                    <SolidColorBrush x:Key="ComboBoxItemThemeForegroundSelectedPointerOver" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardInnerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Styles>
</Application>
