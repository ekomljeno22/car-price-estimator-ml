<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsedCarsApp.ViewModels"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="UsedCarsApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AutoVal · Used Car Price Estimator"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="'Space Grotesk', 'Plus Jakarta Sans', 'Segoe UI', sans-serif" />
            <Setter Property="Foreground" Value="#E5E7EB" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7C8DA4" />
            <Setter Property="Margin" Value="0 0 0 6" />
            <Setter Property="LetterSpacing" Value="1.8" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#1F2A3A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#F97316" Offset="0" />
                        <GradientStop Color="#0EA5E9" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Opacity" Value="0.92" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="BorderBrush" Value="#1F2A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12 0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#F97316" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="BorderBrush" Value="#1F2A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="#0EA5E9" />
        </Style>
    </Window.Styles>

    <Grid>
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" Canvas.Left="-160" Canvas.Top="-120" Opacity="0.25">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#F97316" Offset="0" />
                        <GradientStop Color="#0B0F14" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="640" Height="640" Canvas.Right="-220" Canvas.Top="-180" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#38BDF8" Offset="0" />
                        <GradientStop Color="#0B0F14" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid ColumnDefinitions="380,*">
            
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Classes="card" Padding="28 32" Margin="24 24 12 24">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="6">
                            <TextBlock Text="AUTO" FontSize="11" FontWeight="Bold" Foreground="#F97316" LetterSpacing="4" />
                            <TextBlock Text="VAL" FontSize="40" FontWeight="ExtraBold" Foreground="#F8FAFC" />
                            <TextBlock Text="AI Price Estimator" FontSize="13" Foreground="#94A3B8" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="#1F2A3A" />

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="ZADNJA PROCJENA" />
                            <TextBlock Text="{Binding PredictedPrice}" FontSize="38" FontWeight="ExtraBold" Foreground="#38BDF8" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Model:" FontSize="12" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding ModelUsed}" FontSize="12" Foreground="#E2E8F0" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#1F2A3A" />

                        <StackPanel Spacing="12">
                            <TextBlock Classes="label" Text="TRENUTNI ODABIR" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <Border Grid.Row="0" Grid.Column="0" Background="#0B1220" CornerRadius="10" Padding="12 10" Margin="0 0 6 6">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="MARKA" FontSize="9" Foreground="#6B7280" LetterSpacing="1.5" />
                                        <TextBlock Text="{Binding SelectedBrand, FallbackValue='—'}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#0B1220" CornerRadius="10" Padding="12 10" Margin="6 0 0 6">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="MODEL" FontSize="9" Foreground="#6B7280" LetterSpacing="1.5" />
                                        <TextBlock Text="{Binding SelectedCarModel, FallbackValue='—'}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="#0B1220" CornerRadius="10" Padding="12 10" Margin="0 0 6 0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="GODINA" FontSize="9" Foreground="#6B7280" LetterSpacing="1.5" />
                                        <TextBlock Text="{Binding ModelYear}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="#0B1220" CornerRadius="10" Padding="12 10" Margin="6 0 0 0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="MILJE" FontSize="9" Foreground="#6B7280" LetterSpacing="1.5" />
                                        <TextBlock Text="{Binding Milage, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#1F2A3A" />

                        <StackPanel Spacing="10">
                            <TextBlock Classes="label" Text="STATISTIKA MODELA" />
                            <TextBlock Text="{Binding StatsModelType}" FontSize="12" Foreground="#93C5FD" Margin="0 0 0 4" />
                            <ItemsControl ItemsSource="{Binding StatsCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0B1220" CornerRadius="10" Padding="10" Margin="0 0 6 6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#6B7280" LetterSpacing="1.2" />
                                                <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Accent}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#1F2A3A" />

                        <Border Background="#0B1220" CornerRadius="12" Padding="14 12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoadingModels}">
                                    <Ellipse Width="7" Height="7" Fill="#F59E0B" />
                                    <TextBlock Text="Komunikacija s ML servisom..." FontSize="12" Foreground="#94A3B8" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#7C8DA4" TextWrapping="Wrap" />
                                <Border IsVisible="{Binding HasError}" Background="#2A0B0B" CornerRadius="6" Padding="10 8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="6" Height="6" Fill="#EF4444" />
                                        <TextBlock Text="Greška u povezivanju servisa" FontSize="11" Foreground="#F87171" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12 24 40 24">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Unesi podatke o vozilu" FontSize="30" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Odaberi marku i model iz padajućih izbornika za preciznu procjenu tržišne cijene." FontSize="14" Foreground="#94A3B8" />
                    </StackPanel>

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="18">
                            <TextBlock Classes="label" Text="IDENTIFIKACIJA VOZILA" />
                            
                            <Grid ColumnDefinitions="*,20,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="MARKA (BRAND)" FontSize="11" Foreground="#7C8DA4" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" PlaceholderText="Odaberi marku..." />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="MODEL VOZILA" FontSize="11" Foreground="#7C8DA4" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="učitavam..." FontSize="10" Foreground="#F59E0B" IsVisible="{Binding IsLoadingModels}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding CarModels}" SelectedItem="{Binding SelectedCarModel}" PlaceholderText="Odaberi model..." IsEnabled="{Binding !IsLoadingModels}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto" Margin="0 4 0 0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="GODINA MODELA" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="KILOMETRAŽA (MI)" />

                                <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding ModelYear}" Minimum="1990" Maximum="2027" FormatString="0" />
                                <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Milage}" Minimum="0" Maximum="999999" FormatString="0" Increment="5000" />
                            </Grid>

                            <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto,Auto" Margin="0 4 0 0">

                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="SNAGA (HP)" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="LITRAŽA MOTORA" />

                                <NumericUpDown Grid.Row="3" Grid.Column="0" Value="{Binding Hp}" Minimum="50" Maximum="1000" FormatString="0" />
                                <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding Liters}" Minimum="0.5" Maximum="8.0" FormatString="0.0" Increment="0.1" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="label" Text="POGON I MJENJAČ" />
                            <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="VRSTA GORIVA" />
                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding SelectedFuelType}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="MJENJAČ" />
                                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Transmissions}" SelectedItem="{Binding SelectedTransmission}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="label" Text="POVIJEST VOZILA" />
                            <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="NEZGODE" />
                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Accidents}" SelectedItem="{Binding SelectedAccident}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="ČIST PAPIR (TITLE)" />
                                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding CleanTitles}" SelectedItem="{Binding SelectedCleanTitle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Classes="primary" Command="{Binding PredictCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <TextBlock IsVisible="{Binding !IsBusy}" Text="Procijeni vrijednost vozila" FontSize="16" Foreground="White" />
                            <TextBlock IsVisible="{Binding IsBusy}" Text="Model kalkulira..." FontSize="16" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Background="#D5070A11" IsVisible="{Binding ShowResultPopup}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="card" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" CornerRadius="18" Background="#0F172A" BorderBrush="#253346" BorderThickness="1.5">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="PROCJENA USPJEŠNA" FontSize="11" FontWeight="Bold" Foreground="#F97316" HorizontalAlignment="Center" LetterSpacing="2" />
                        <TextBlock Text="Rezultat AI Analize" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Background="#1E293B" CornerRadius="12" Padding="26" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PredictedPrice}" FontSize="46" FontWeight="ExtraBold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Korišteni algoritam:" FontSize="12" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding ModelUsed}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="12">
                        <TextBlock Text="SINTETIZIRANI PODACI" FontSize="10" FontWeight="Bold" Foreground="#475569" LetterSpacing="1" />
                        
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="Marka i model:" FontSize="13" Foreground="#94A3B8" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{Binding SelectedBrand}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                <TextBlock Text="{Binding SelectedCarModel}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#1E293B" />
                        
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="Godina proizvodnje:" FontSize="13" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="1" Text="{Binding ModelYear}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                        </Grid>
                        <Rectangle Height="1" Fill="#1E293B" />
                        
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="Kilometraža:" FontSize="13" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="1" Text="{Binding Milage, StringFormat='{}{0:N0} mi'}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                        </Grid>
                        <Rectangle Height="1" Fill="#1E293B" />
                        
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="Konfiguracija:" FontSize="13" Foreground="#94A3B8" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedFuelType} / {Binding SelectedTransmission}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <Button Classes="primary" Content="Zatvori procjenu" Command="{Binding ClosePopupCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="48" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>