<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsedCarsApp.ViewModels"
        x:Class="UsedCarsApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Used Car Price Predictor"
        WindowState="Maximized"
        Background="#F1F5F9">

    <Window.DataContext>
        <Binding Path="Main" Source="{ReflectionBinding $parent[Application].DataContext}"/>
    </Window.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" Margin="40 30" Spacing="24">

            <Border CornerRadius="16" Padding="32 24" BoxShadow="0 4 18 0 #20000000">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#1E40AF" />
                        <GradientStop Offset="1" Color="#2563EB" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Spacing="6" Grid.Column="0">
                        <TextBlock Text="🚗  Used Car Price Predictor"
                                   FontSize="26" FontWeight="Heavy"
                                   Foreground="White" LetterSpacing="0.5" />
                        <TextBlock Text="Advanced ML-powered estimation engine using deep neural networks"
                                   FontSize="14" Foreground="#93C5FD" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#3B82F6" CornerRadius="8" Padding="12 6" VerticalAlignment="Center">
                        <TextBlock Text="v2.0 Live" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, 32, 400" HorizontalAlignment="Stretch">
                
                <Border Grid.Column="0" Background="White" CornerRadius="16"
                        BoxShadow="0 4 20 0 #0F000000" Padding="32">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Vehicle Specifications" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0 0 0 10"/>
                        
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*, 24, *">

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0 0 0 16">
                                <TextBlock Text="Model Year" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <NumericUpDown Value="{Binding ModelYear}" Minimum="1990" Maximum="2026" FormatString="0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6" Margin="0 0 0 16">
                                <TextBlock Text="Mileage (mi)" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <NumericUpDown Value="{Binding Milage}" Minimum="0" Maximum="999999" FormatString="0" Increment="5000" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6" Margin="0 0 0 16">
                                <TextBlock Text="Brand" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6" Margin="0 0 0 16">
                                <TextBlock Text="Model" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <ComboBox ItemsSource="{Binding CarModels}" SelectedItem="{Binding SelectedCarModel}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6" Margin="0 0 0 16">
                                <TextBlock Text="Fuel Type" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <ComboBox ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding SelectedFuelType}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="6" Margin="0 0 0 16">
                                <TextBlock Text="Transmission" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <ComboBox ItemsSource="{Binding Transmissions}" SelectedItem="{Binding SelectedTransmission}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.Column="0" Spacing="6">
                                <TextBlock Text="Prior Accident" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <ComboBox ItemsSource="{Binding Accidents}" SelectedItem="{Binding SelectedAccident}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.Column="2" Spacing="6">
                                <TextBlock Text="Clean Title" FontWeight="SemiBold" FontSize="13" Foreground="#475569" />
                                <ComboBox ItemsSource="{Binding CleanTitles}" SelectedItem="{Binding SelectedCleanTitle}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Spacing="20" VerticalAlignment="Top">
                    
                    <Border CornerRadius="12" BoxShadow="0 4 14 0 #402563EB">
                        <Button Command="{Binding PredictCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Height="56" Background="#2563EB" Foreground="White"
                                FontSize="16" FontWeight="Bold" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="M12 2A10 10 0 0 0 2 12A10 10 0 0 0 12 22A10 10 0 0 0 22 12A10 10 0 0 0 12 2M12 4A8 8 0 0 1 20 12A8 8 0 0 1 12 20A8 8 0 0 1 4 12A8 8 0 0 1 12 4M11 6V13H16V11H13V6H11Z" 
                                          Width="16" Height="16" Foreground="White" IsVisible="{Binding !IsBusy}"/>
                                <TextBlock IsVisible="{Binding !IsBusy}" Text="Calculate Valuation" VerticalAlignment="Center"/>
                                <TextBlock IsVisible="{Binding IsBusy}"  Text="Running Valuation Model…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Background="White" CornerRadius="16" BoxShadow="0 4 20 0 #0F000000" Padding="28">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="ESTIMATED VALUE" FontSize="12" FontWeight="Heavy" 
                                       Foreground="#64748B" HorizontalAlignment="Center" LetterSpacing="1.2"/>
                            
                            <TextBlock Text="{Binding PredictedPrice}" FontSize="46" FontWeight="Black" 
                                       HorizontalAlignment="Center" Foreground="#16A34A" />
                            
                            <Border Background="#F0FDF4" CornerRadius="20" Padding="12 4" HorizontalAlignment="Center">
                                <TextBlock Text="✓ AI Verified Estimate" FontSize="11" Foreground="#16A34A" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="16 12" Background="#E2E8F0">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Text="ℹ " FontSize="14" Foreground="#475569" Grid.Column="0" Margin="0 0 8 0"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569" 
                                       TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>