<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsedCarsApp.ViewModels"
        x:Class="UsedCarsApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AutoVal · Used Car Price Estimator"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F1E">

    <Window.Styles>

        <!-- ── Globalni font ───────────────────────────────────────── -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="'Segoe UI', 'SF Pro Display', sans-serif" />
            <Setter Property="Foreground"  Value="#E2E8F0" />
        </Style>

        <!-- ── Label iznad fielda ─────────────────────────────────── -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin"     Value="0 0 0 6" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>

        <!-- ── ComboBox ───────────────────────────────────────────── -->
        <Style Selector="ComboBox">
            <Setter Property="Background"           Value="#111827" />
            <Setter Property="BorderBrush"          Value="#1E293B" />
            <Setter Property="BorderThickness"      Value="1" />
            <Setter Property="Foreground"           Value="#E2E8F0" />
            <Setter Property="Height"               Value="44" />
            <Setter Property="CornerRadius"         Value="8" />
            <Setter Property="Padding"              Value="12 0" />
            <Setter Property="HorizontalAlignment"  Value="Stretch" />
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>

        <!-- ── NumericUpDown ──────────────────────────────────────── -->
        <Style Selector="NumericUpDown">
            <Setter Property="Background"      Value="#111827" />
            <Setter Property="BorderBrush"     Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground"      Value="#E2E8F0" />
            <Setter Property="Height"          Value="44" />
            <Setter Property="CornerRadius"    Value="8" />
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>

    </Window.Styles>

    <!-- ═══════════════════════════════════════════════════════════
         ROOT: dva stupca – lijeva sidebar + desni sadržaj
    ══════════════════════════════════════════════════════════════ -->
    <Grid ColumnDefinitions="320,*">

        <!-- ══════════════════════════════════════════
             LIJEVA SIDEBAR – brend / naslov / info
        ═══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#060D1A"
                Padding="36 48 36 36">
            <DockPanel>

                <!-- Logo + naslov -->
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0 0 0 48">
                    <TextBlock Text="AUTO"
                               FontSize="11" FontWeight="Bold"
                               Foreground="#3B82F6"
                               LetterSpacing="4" />
                    <TextBlock Text="VAL"
                               FontSize="42" FontWeight="ExtraBold"
                               Foreground="#F1F5F9"
                               LineHeight="40" />
                    <Rectangle Height="2" Width="48"
                               Fill="#3B82F6"
                               HorizontalAlignment="Left"
                               Margin="0 8 0 0" />
                    <TextBlock Text="AI Price Estimator"
                               FontSize="13" Foreground="#475569"
                               Margin="0 8 0 0" />
                </StackPanel>

                <!-- Status badge -->
                <Border DockPanel.Dock="Bottom"
                        Background="#0F172A"
                        CornerRadius="10"
                        Padding="14 12"
                        Margin="0 0 0 0">
                    <StackPanel Spacing="10">

                        <!-- Indikator učitavanja modela -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding IsLoadingModels}">
                            <Ellipse Width="7" Height="7" Fill="#F59E0B" />
                            <TextBlock Text="Učitavam modele…"
                                       FontSize="12" Foreground="#94A3B8" />
                        </StackPanel>

                        <!-- Status poruka -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !IsLoadingModels}" />

                        <!-- Error badge -->
                        <Border IsVisible="{Binding HasError}"
                                Background="#1A0A0A" CornerRadius="6"
                                Padding="10 8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6" Height="6" Fill="#EF4444" />
                                <TextBlock Text="Greška – provjeri servise"
                                           FontSize="11" Foreground="#EF4444" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Spacer -->
                <StackPanel DockPanel.Dock="Top" Spacing="32">

                    <!-- ── Procijenjena cijena (veliki prikaz) ── -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="PROCIJENJENA CIJENA" />
                        <TextBlock Text="{Binding PredictedPrice}"
                                   FontSize="44" FontWeight="ExtraBold"
                                   Foreground="#3B82F6"
                                   LineHeight="48" />
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#1E293B" />

                    <!-- ── Info kartice ── -->
                    <StackPanel Spacing="12">
                        <TextBlock Classes="label" Text="MODEL INFO" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              HorizontalAlignment="Stretch">
                            <!-- Brand prikaz -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#0F172A" CornerRadius="8"
                                    Padding="12 10" Margin="0 0 6 6">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="BRAND" FontSize="9"
                                               Foreground="#475569" LetterSpacing="1.5" />
                                    <TextBlock Text="{Binding SelectedBrand, FallbackValue='—'}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>
                            <!-- Model prikaz -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Background="#0F172A" CornerRadius="8"
                                    Padding="12 10" Margin="6 0 0 6">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="MODEL" FontSize="9"
                                               Foreground="#475569" LetterSpacing="1.5" />
                                    <TextBlock Text="{Binding SelectedCarModel, FallbackValue='—'}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#CBD5E1"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <!-- Godina prikaz -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="#0F172A" CornerRadius="8"
                                    Padding="12 10" Margin="0 0 6 0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="GODINA" FontSize="9"
                                               Foreground="#475569" LetterSpacing="1.5" />
                                    <TextBlock Text="{Binding ModelYear}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>
                            <!-- Milja prikaz -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="#0F172A" CornerRadius="8"
                                    Padding="12 10" Margin="6 0 0 0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="MILJE" FontSize="9"
                                               Foreground="#475569" LetterSpacing="1.5" />
                                    <TextBlock Text="{Binding Milage, StringFormat='{}{0:N0}'}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             DESNA STRANA – form
        ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0">
            <StackPanel Margin="48 48 48 48" Spacing="0">

                <!-- Naslov sekcije -->
                <StackPanel Spacing="4" Margin="0 0 0 36">
                    <TextBlock Text="Unesi podatke o vozilu"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#F1F5F9" />
                    <TextBlock Text="Ispuni polja za preciznu procjenu tržišne vrijednosti."
                               FontSize="14" Foreground="#475569" />
                </StackPanel>

                <!-- ── Sekcija: Osnovno ─────────────────────────────── -->
                <TextBlock Classes="label" Text="OSNOVNO" Margin="0 0 0 12" />
                <Border Background="#0F172A" CornerRadius="12"
                        Padding="24" Margin="0 0 0 24">
                    <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto,Auto,Auto">

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="MARKA (BRAND)" />
                        <ComboBox  Grid.Row="1" Grid.Column="0"
                                   ItemsSource="{Binding Brands}"
                                   SelectedItem="{Binding SelectedBrand}"
                                   Margin="0 0 0 20" />

                        <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label" Text="MODEL" />
                            <TextBlock Grid.Column="1"
                                       Text="učitavam…" FontSize="10"
                                       Foreground="#F59E0B"
                                       IsVisible="{Binding IsLoadingModels}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ComboBox  Grid.Row="1" Grid.Column="2"
                                   ItemsSource="{Binding CarModels}"
                                   SelectedItem="{Binding SelectedCarModel}"
                                   IsEnabled="{Binding !IsLoadingModels}"
                                   Margin="0 0 0 20" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="GODINA MODELA" />
                        <NumericUpDown Grid.Row="3" Grid.Column="0"
                                       Value="{Binding ModelYear}"
                                       Minimum="1990" Maximum="2025"
                                       FormatString="0" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" Text="KILOMETRAŽA (MI)" />
                        <NumericUpDown Grid.Row="3" Grid.Column="2"
                                       Value="{Binding Milage}"
                                       Minimum="0" Maximum="999999"
                                       FormatString="0" Increment="5000" />
                    </Grid>
                </Border>

                <!-- ── Sekcija: Pogon ───────────────────────────────── -->
                <TextBlock Classes="label" Text="POGON I MJENJAČ" Margin="0 0 0 12" />
                <Border Background="#0F172A" CornerRadius="12"
                        Padding="24" Margin="0 0 0 24">
                    <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="VRSTA GORIVA" />
                        <ComboBox  Grid.Row="1" Grid.Column="0"
                                   ItemsSource="{Binding FuelTypes}"
                                   SelectedItem="{Binding SelectedFuelType}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="MJENJAČ" />
                        <ComboBox  Grid.Row="1" Grid.Column="2"
                                   ItemsSource="{Binding Transmissions}"
                                   SelectedItem="{Binding SelectedTransmission}" />
                    </Grid>
                </Border>

                <!-- ── Sekcija: Povijest ────────────────────────────── -->
                <TextBlock Classes="label" Text="POVIJEST VOZILA" Margin="0 0 0 12" />
                <Border Background="#0F172A" CornerRadius="12"
                        Padding="24" Margin="0 0 0 36">
                    <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="NEZGODE" />
                        <ComboBox  Grid.Row="1" Grid.Column="0"
                                   ItemsSource="{Binding Accidents}"
                                   SelectedItem="{Binding SelectedAccident}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="ČIST PAPIR" />
                        <ComboBox  Grid.Row="1" Grid.Column="2"
                                   ItemsSource="{Binding CleanTitles}"
                                   SelectedItem="{Binding SelectedCleanTitle}" />
                    </Grid>
                </Border>

                <!-- ── Predict button ───────────────────────────────── -->
                <Button Command="{Binding PredictCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="56"
                        CornerRadius="12"
                        Cursor="Hand">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#2563EB" Offset="0" />
                            <GradientStop Color="#7C3AED" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="White" />
                    </Button.Foreground>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock IsVisible="{Binding !IsBusy}"
                                   Text="Procijeni cijenu →"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock IsVisible="{Binding IsBusy}"
                                   Text="Računam…"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" />
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>